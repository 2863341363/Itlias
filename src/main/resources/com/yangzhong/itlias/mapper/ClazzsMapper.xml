<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yangzhong.itlias.mapper.ClazzsMapper">
    <select id="selectClazzsList" resultType="com.yangzhong.itlias.entity.Clazz">
        select id,name,room,begin_date,end_date,master_id,create_time,update_time,master_name,status from clazz
        <where>
            <if test="clazz.name!=null and clazz.name!=''">
                name = #{clazz.name}
            </if>
        <if test="page.begin!=null and page.end != null">
           and end_date between #{page.begin} and #{page.end}
        </if>
        </where>
    </select>


    <delete id="deleteClazzs">
        delete from clazz where id = #{id}
    </delete>

    <insert id="addClazz">
        insert into clazz(name,room,begin_date,end_date,master_id,subject) values (#{clazz.name},#{clazz.room},#{clazz.beginDate},#{clazz.endDate},#{clazz.masterId},#{clazz.subject})
    </insert>

    <select id="selectClazzById" resultType="com.yangzhong.itlias.entity.Clazz">
        select id,name,room,begin_date,end_date,master_id,subject,create_time,update_time from clazz where id =#{id}
    </select>




    <update id="updateClazz">
        update clazz <set>
        <if test="name !=null and name != ''">name = #{name},</if>
        <if test="beginDate !=null">begin_date = #{beginDate},</if>
        <if test="endDate !=null">end_date = #{endDate},</if>
        <if test="masterId !=null">master_id = #{masterId},</if>
        <if test="room !=null"> room = #{room},</if>
        <if test="subject !=null">subject = #{subject},</if>
    </set>
        where id = #{id}
    </update>

    <select id="selectAllClazzs" resultType="com.yangzhong.itlias.entity.Clazz">
        select id,name,room,begin_date,end_date,master_id,subject,create_time,update_time from clazz
    </select>
</mapper>